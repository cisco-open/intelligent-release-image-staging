#
# Non-secret console configuration. kustomization.yaml generates a content-
# hashed ConfigMap from this file, so `kubectl apply -k kubernetes` rolls only
# the console when one of these values changes.

IRIS_MANAGEMENT_API_URL=https://iris-server-api:9443
IRIS_GUI_HOST=0.0.0.0
IRIS_GUI_PORT=8080
PYTHONDONTWRITEBYTECODE=1
