#
# Environment for the iris-seed-server ConfigMap. kustomization.yaml turns
# this file into a ConfigMap through configMapGenerator, which suffixes the
# ConfigMap name with a content hash and rewrites the Deployment's
# configMapRef to match -- so every edit here rolls the pod on the next
# `kubectl apply -k`. (A plain ConfigMap resource would be updated in place
# and the running pod would never see the change.)
#
# KEY=VALUE, one per line; values are literal (no quotes).

# Replace both sentinel values before deployment. IRIS_HOST_IP must be the
# stable, device-reachable IPv4 address on the LoadBalancer Service.
IRIS_HOST_IP=REPLACE_WITH_STATIC_EXTERNAL_IP
IRIS_AGE_RECIPIENTS=REPLACE_WITH_AGE_RECIPIENTS

IRIS_STATE=/data/state
IRIS_CONFIG=/data/config
IRIS_LOG=/data/log
IRIS_RUN=/run/iris
IRIS_SECRETS=/run/iris/secrets.json
IRIS_RPC_SECRET_FILE=/run/iris/rpc-secret
IRIS_CERT=/run/iris/tls/cert.pem
IRIS_SECRETS_ENC=/data/config/secrets.json.age
IRIS_AUDIT=/data/config/audit.jsonl
IRIS_IMAGES_DIR=/data/images
IRIS_ARTIFACTS_DIR=/data/artifacts
IMAGES_ROOT=/data/images
IMAGES_DIR=/data/images

IRIS_OBSERVABILITY=
IRIS_OTLP_ENDPOINT=
# Optional. Overrides the console link on the :9101 pointer page AND the
# console port shown on the Settings page. Set it (e.g.
# https://<external-ip>:8080/) if you front the console on a non-8080
# external port; otherwise the Settings page shows the Service port 8080.
IRIS_CONSOLE_URL=
# Device SSH transports keep a persistent known_hosts under $IRIS_STATE/ssh
# (on the PVC). Set IRIS_SSH_LEGACY=1 only for devices that still need the
# legacy SSH KEX/cipher set; it is off by default.
IRIS_SSH_LEGACY=0
PYTHONDONTWRITEBYTECODE=1
