diff --git a/src/BtPeerRevocations.cc b/src/BtPeerRevocations.cc
new file mode 100644
index 0000000..a58281f
--- /dev/null
+++ b/src/BtPeerRevocations.cc
@@ -0,0 +1,228 @@
+// Copyright 2026 Cisco Systems, Inc. and its affiliates
+// SPDX-License-Identifier: GPL-2.0-or-later
+// IRIS addition, 2026-10-10: bounded, fail-closed peer identity revocation.
+#include "BtPeerRevocations.h"
+
+#include <algorithm>
+#include <ctime>
+#include <fcntl.h>
+#include <limits>
+#include <memory>
+#include <sstream>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+#include <openssl/pem.h>
+#include <openssl/x509v3.h>
+
+namespace aria2 {
+namespace {
+constexpr size_t MAX_BYTES = 1024 * 1024;
+constexpr size_t MAX_IDENTITIES = 10000;
+constexpr uint64_t MAX_INTEGER = 9007199254740991ULL;
+
+bool hexIdentity(const std::string& value)
+{
+  return value.size() == 64 && std::all_of(value.begin(), value.end(),
+      [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+}
+
+bool number(const std::string& value, uint64_t& result)
+{
+  if (value.empty() || (value.size() > 1 && value[0] == '0')) return false;
+  result = 0;
+  for (char c : value) {
+    if (c < '0' || c > '9' || result > (MAX_INTEGER - (c - '0')) / 10)
+      return false;
+    result = result * 10 + (c - '0');
+  }
+  return true;
+}
+
+std::string fingerprint(X509* certificate)
+{
+  unsigned char digest[EVP_MAX_MD_SIZE];
+  unsigned int length = 0;
+  if (!certificate || X509_digest(certificate, EVP_sha256(), digest, &length) != 1
+      || length != 32) return {};
+  const char hex[] = "0123456789abcdef";
+  std::string result;
+  for (unsigned int i = 0; i < length; ++i) {
+    result += hex[digest[i] >> 4];
+    result += hex[digest[i] & 15];
+  }
+  return result;
+}
+
+bool current(X509* certificate)
+{
+  return certificate && X509_cmp_current_time(X509_get0_notBefore(certificate)) < 0
+      && X509_cmp_current_time(X509_get0_notAfter(certificate)) > 0;
+}
+} // namespace
+
+std::string BtPeerRevocations::identity(X509* certificate)
+{
+  if (!certificate) return {};
+  int critical = -1;
+  auto names = static_cast<GENERAL_NAMES*>(
+      X509_get_ext_d2i(certificate, NID_subject_alt_name, &critical, nullptr));
+  if (!names || critical == -2) {
+    GENERAL_NAMES_free(names);
+    return {};
+  }
+  std::string result;
+  bool invalid = false;
+  const std::string prefix = "urn:iris:device:";
+  for (int i = 0; i < sk_GENERAL_NAME_num(names); ++i) {
+    const auto name = sk_GENERAL_NAME_value(names, i);
+    if (name->type != GEN_URI) continue;
+    const auto uri = name->d.uniformResourceIdentifier;
+    std::string value(reinterpret_cast<const char*>(ASN1_STRING_get0_data(uri)),
+                      static_cast<size_t>(ASN1_STRING_length(uri)));
+    if (value.compare(0, prefix.size(), prefix) != 0) continue;
+    auto candidate = value.substr(prefix.size());
+    if (!result.empty() || !hexIdentity(candidate)) invalid = true;
+    result = candidate;
+  }
+  GENERAL_NAMES_free(names);
+  return invalid ? std::string{} : result;
+}
+
+BtPeerRevocations::BtPeerRevocations(const std::string& path,
+                                   const std::string& ca,
+                                   X509* localCertificate)
+    : path_(path), localIdentity_(identity(localCertificate))
+{
+  localCertificate_ = std::shared_ptr<X509>(X509_dup(localCertificate), X509_free);
+  std::unique_ptr<BIO, decltype(&BIO_free)> input(
+      BIO_new_file(ca.c_str(), "r"), BIO_free);
+  std::unique_ptr<X509, decltype(&X509_free)> certificate(
+      input ? PEM_read_bio_X509(input.get(), nullptr, nullptr, nullptr) : nullptr,
+      X509_free);
+  caHash_ = fingerprint(certificate.get());
+}
+
+std::shared_ptr<BtPeerRevocations> BtPeerRevocations::shared(
+    const std::string& path, const std::string& ca, X509* certificate)
+{
+  // aria2 configures one client and one server context on its event-loop
+  // thread. Both must use exactly the enforcement state exposed over RPC.
+  static std::weak_ptr<BtPeerRevocations> current;
+  auto previous = current.lock();
+  auto candidate = std::make_shared<BtPeerRevocations>(path, ca, certificate);
+  if (previous && previous->path_ == path && previous->caHash_ == candidate->caHash_
+      && fingerprint(previous->localCertificate_.get()) == fingerprint(certificate))
+    return previous;
+  current = candidate;
+  return candidate;
+}
+
+bool BtPeerRevocations::load()
+{
+  if (path_.empty() || path_[0] != '/' || caHash_.empty() || localIdentity_.empty())
+    return false;
+  int fd = open(path_.c_str(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0) return false;
+  struct stat before{}, after{};
+  bool safe = fstat(fd, &before) == 0 && S_ISREG(before.st_mode)
+      && !(before.st_mode & 0022)
+      && (before.st_uid == geteuid() || before.st_uid == 0)
+      && before.st_size > 0 && before.st_size <= static_cast<off_t>(MAX_BYTES);
+  std::string bytes;
+  if (safe) {
+    bytes.resize(static_cast<size_t>(before.st_size));
+    size_t offset = 0;
+    while (offset < bytes.size()) {
+      auto count = read(fd, &bytes[offset], bytes.size() - offset);
+      if (count <= 0) { safe = false; break; }
+      offset += static_cast<size_t>(count);
+    }
+    char extra;
+    if (safe && read(fd, &extra, 1) != 0) safe = false;
+    if (fstat(fd, &after) != 0 || before.st_size != after.st_size ||
+        before.st_mtim.tv_sec != after.st_mtim.tv_sec ||
+        before.st_mtim.tv_nsec != after.st_mtim.tv_nsec) safe = false;
+  }
+  close(fd);
+  if (!safe || bytes.empty() || bytes.back() != '\n') return false;
+  std::istringstream input(bytes);
+  std::vector<std::string> rows;
+  std::string line;
+  while (std::getline(input, line)) {
+    if (rows.size() == MAX_IDENTITIES + 5) return false;
+    rows.push_back(line);
+  }
+  if (rows.size() < 5 || rows[0] != "IRIS-PEER-REVOCATIONS-1" ||
+      rows[1] != caHash_) return false;
+  uint64_t revision, issued, expires;
+  if (!number(rows[2], revision) || !number(rows[3], issued) ||
+      !number(rows[4], expires) || expires <= issued || expires - issued > 300)
+    return false;
+  const auto wall = std::time(nullptr);
+  if (wall < 0) return false;
+  const auto now = static_cast<uint64_t>(wall);
+  if (issued > now + 30 || expires <= now) return false;
+  std::set<std::string> denied;
+  for (size_t i = 5; i < rows.size(); ++i) {
+    if (!hexIdentity(rows[i]) || (i > 5 && rows[i] <= rows[i - 1])) return false;
+    denied.insert(rows[i]);
+  }
+  if (initialized_ && (revision < revision_ || issued < issued_ ||
+      (revision == revision_ && denied != denied_) ||
+      (issued == issued_ && expires != expires_))) return false;
+  const auto steady = std::chrono::steady_clock::now();
+  if (!initialized_ || issued > issued_) {
+    deadline_ = steady + std::chrono::seconds(std::min<uint64_t>(300, expires - now));
+  }
+  // Re-reading the same file must not extend its lease after a clock rollback.
+  if (steady >= deadline_) return false;
+  denied_ = std::move(denied);
+  revision_ = revision;
+  issued_ = issued;
+  expires_ = expires;
+  initialized_ = true;
+  return true;
+}
+
+bool BtPeerRevocations::refresh()
+{
+  auto now = std::chrono::steady_clock::now();
+  if (now >= nextRead_) {
+    nextRead_ = now + std::chrono::seconds(1);
+    valid_ = load();
+  }
+  auto wall = std::time(nullptr);
+  return valid_ && wall >= 0 && static_cast<uint64_t>(wall) < expires_ &&
+      now < deadline_;
+}
+
+bool BtPeerRevocations::allowed(X509* peer, bool requirePeer)
+{
+  if (!refresh() || !current(localCertificate_.get()) || denied_.count(localIdentity_))
+    return false;
+  if (!requirePeer) return true;
+  auto peerIdentity = identity(peer);
+  return current(peer) && !peerIdentity.empty() && !denied_.count(peerIdentity);
+}
+
+BtPeerRevocationState BtPeerRevocations::status()
+{
+  BtPeerRevocationState result;
+  result.supported = true;
+  result.required = true;
+  const bool fresh = refresh();
+  result.authority = caHash_;
+  if (initialized_) {
+    result.revision = static_cast<int64_t>(revision_);
+    result.issued = static_cast<int64_t>(issued_);
+    result.expires = static_cast<int64_t>(expires_);
+    result.ownRevoked = denied_.count(localIdentity_) != 0;
+  }
+  if (fresh) result.state = "valid";
+  else if (initialized_ && (std::time(nullptr) >= static_cast<time_t>(expires_) ||
+                           std::chrono::steady_clock::now() >= deadline_))
+    result.state = "expired";
+  return result;
+}
+} // namespace aria2
