+std::unique_ptr<ValueBase>
+GetPeerTLSRevocationStatusRpcMethod::process(const RpcRequest& req, DownloadEngine* e)
+{
+  const auto state = SocketCore::btPeerRevocationState();
+  auto result = Dict::g();
+  result->put("supported", state.supported ? Bool::gTrue() : Bool::gFalse());
+  result->put("mode", state.required ? "required" : "disabled");
+  result->put("state", state.state);
+  result->put("own_revoked", state.ownRevoked ? Bool::gTrue() : Bool::gFalse());
+  if (state.authority.empty()) result->put("authority", Null::g());
+  else result->put("authority", state.authority);
+  for (const auto& field : {std::make_pair("revision", state.revision),
+                           std::make_pair("issued_at", state.issued),
+                           std::make_pair("expires_at", state.expires)}) {
+    if (field.second < 0) result->put(field.first, Null::g());
+    else result->put(field.first, Integer::g(field.second));
+  }
+  return result;
+}
