+// Copyright 2026 Cisco Systems, Inc. and its affiliates
+// SPDX-License-Identifier: GPL-2.0-or-later
+// IRIS addition, 2026-10-10: bounded, fail-closed peer identity revocation.
+#ifndef D_BT_PEER_REVOCATIONS_H
+#define D_BT_PEER_REVOCATIONS_H
+
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <set>
+#include <string>
+#include <openssl/x509.h>
+#include "BtPeerRevocationState.h"
+
+namespace aria2 {
+
+// The protected local snapshot is delivered over the pinned catalog HTTPS
+// connection. It is not a CRL, a bearer credential, or an IP block list.
+class BtPeerRevocations {
+public:
+  BtPeerRevocations(const std::string& path, const std::string& ca,
+                    X509* localCertificate);
+  static std::shared_ptr<BtPeerRevocations> shared(
+      const std::string& path, const std::string& ca, X509* certificate);
+  bool allowed(X509* peer, bool requirePeer = true);
+  BtPeerRevocationState status();
+  static std::string identity(X509* certificate);
+
+private:
+  bool refresh();
+  bool load();
+  std::string path_;
+  std::string caHash_;
+  std::string localIdentity_;
+  std::shared_ptr<X509> localCertificate_;
+  std::set<std::string> denied_;
+  uint64_t revision_ = 0;
+  uint64_t issued_ = 0;
+  uint64_t expires_ = 0;
+  bool initialized_ = false;
+  bool valid_ = false;
+  std::chrono::steady_clock::time_point nextRead_{};
+  std::chrono::steady_clock::time_point deadline_{};
+};
+
+} // namespace aria2
+#endif
