 namespace {
 constexpr auto FLOODING_CHECK_INTERVAL = 5_s;
+// How long a seeder<->seeder connection is kept once both sides are known
+// to be complete, before "Good Bye Seeder". Upstream drops it at once,
+// here and in the HAVE / HAVE_ALL / BITFIELD handlers that now defer to
+// this check. IRIS reads the per-peer session counters through
+// aria2.getPeers from the --on-bt-download-complete hook, which is exec'd
+// when the last piece lands and reaches the RPC loop only after a
+// fork+exec+curl round trip; a peer erased in the same event-loop
+// iteration -- on either end of the connection -- is missing from that
+// answer. Five seconds covers a slow single-vCPU device many times over.
+constexpr auto SEEDER_GOODBYE_GRACE = 5_s;
 } // namespace
 
 void DefaultBtInteractive::detectMessageFlooding()
@@ -507,9 +518,20 @@ void DefaultBtInteractive::checkActiveInteraction()
           fmt(EX_DROP_INACTIVE_CONNECTION, static_cast<long int>(interval)));
     }
   }
-  // If both of us are seeders, drop connection.
+  // If both of us are seeders, drop connection -- after a grace period
+  // measured from the first iteration that saw both sides complete. The
+  // inactivity drops above are unchanged and still apply meanwhile.
   if (peer_->isSeeder() && pieceStorage_->downloadFinished()) {
-    throw DL_ABORT_EX(MSG_GOOD_BYE_SEEDER);
+    if (seedersSinceTimer_.isZero()) {
+      seedersSinceTimer_ = global::wallclock();
+    }
+    else if (seedersSinceTimer_.difference(global::wallclock()) >=
+             SEEDER_GOODBYE_GRACE) {
+      throw DL_ABORT_EX(MSG_GOOD_BYE_SEEDER);
+    }
+  }
+  else {
+    seedersSinceTimer_ = Timer::zero();
   }
 }
 
