+void RequestGroupTest::testTorrentTrackerRequest()
+{
+  RequestGroup payload(GroupId::create(), option_);
+  REQUIRE_EQ(false, payload.isTorrentTrackerRequest());
+  payload.markInMemoryDownload();
+  REQUIRE_EQ(false, payload.isTorrentTrackerRequest());
+
+  RequestGroup tracker(GroupId::create(), option_);
+  tracker.markTorrentTrackerRequest();
+  REQUIRE_EQ(true, tracker.isTorrentTrackerRequest());
+  REQUIRE_EQ(false, payload.isTorrentTrackerRequest());
+}
