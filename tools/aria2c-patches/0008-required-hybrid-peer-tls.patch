+#include "BtPeerTLSCommand.h"
+#include "SocketCore.h"
+#include "Peer.h"
+#include "PeerConnection.h"
+#include "DownloadEngine.h"
+#include "RequestGroup.h"
+#include "RequestGroupMan.h"
+#include "BtRuntime.h"
+#include "PeerStorage.h"
+#include "PeerReceiveHandshakeCommand.h"
+#include "PeerInteractionCommand.h"
+#include "DlAbortEx.h"
+#include "a2functional.h"
+#include "Log.h"
+#include "fmt.h"
+namespace aria2 {
+size_t BtPeerTLSCommand::pending_ = 0;
+BtPeerTLSCommand::BtPeerTLSCommand(cuid_t cuid, const std::shared_ptr<Peer>& peer,
+    DownloadEngine* engine, const std::shared_ptr<SocketCore>& socket,
+    RequestGroup* group, std::shared_ptr<BtRuntime> runtime,
+    std::shared_ptr<PeerStorage> peers, std::shared_ptr<PieceStorage> pieces)
+    : PeerAbstractCommand(cuid, peer, engine, socket), group_(group),
+      runtime_(std::move(runtime)), peers_(std::move(peers)), pieces_(std::move(pieces)),
+      started_(std::chrono::steady_clock::now())
+{
+  ++pending_;
+  setTimeout(std::chrono::seconds(10));
+  if (group_) {
+    group_->increaseNumCommand(); runtime_->increaseConnections();
+    disableReadCheckSocket(); setWriteCheckSocket(socket);
+  }
+}
+BtPeerTLSCommand::~BtPeerTLSCommand()
+{
+  --pending_;
+  if (group_) {
+    if (!handedOff_) peers_->returnPeer(getPeer());
+    group_->decreaseNumCommand(); runtime_->decreaseConnections();
+  }
+}
+bool BtPeerTLSCommand::exitBeforeExecute()
+{
+  return getDownloadEngine()->isHaltRequested() ||
+      (runtime_ && runtime_->isHalt()) ||
+      getDownloadEngine()->getRequestGroupMan()->downloadFinished();
+}
+bool BtPeerTLSCommand::executeInternal()
+try {
+  if (std::chrono::steady_clock::now() - started_ >= std::chrono::seconds(10))
+    throw DL_ABORT_EX("Private peer TLS handshake deadline exceeded");
+  if (group_ && !connected_) {
+    if (!getSocket()->isWritable(0)) { addCommandSelf(); return false; }
+    auto err = getSocket()->getSocketError();
+    if (!err.empty()) throw DL_ABORT_EX(err);
+    connected_ = true;
+  }
+  if (!getSocket()->tlsPeerHandshake(!group_)) {
+    if (getSocket()->wantRead()) setReadCheckSocket(getSocket()); else disableReadCheckSocket();
+    if (getSocket()->wantWrite()) setWriteCheckSocket(getSocket()); else disableWriteCheckSocket();
+    addCommandSelf(); return false;
+  }
+  A2_LOG_INFO(fmt("BT peer TLS established peer=%s:%u", getPeer()->getIPAddress().c_str(),
+                  getPeer()->getRemotePort()));
+  if (group_) {
+    getDownloadEngine()->addCommand(make_unique<PeerInteractionCommand>(
+        getCuid(), group_, getPeer(), getDownloadEngine(), runtime_, pieces_, peers_,
+        getSocket(), PeerInteractionCommand::INITIATOR_SEND_HANDSHAKE));
+  }
+  else {
+    getDownloadEngine()->addCommand(make_unique<PeerReceiveHandshakeCommand>(
+        getCuid(), getPeer(), getDownloadEngine(), getSocket()));
+  }
+  handedOff_ = true;
+  return true;
+}
+catch (RecoverableException& ex) {
+  A2_LOG_INFO_EX("BT peer TLS rejected before BitTorrent handshake", ex);
+  throw;
+}
+}
