diff --git a/src/LibsslTLSContext.cc b/src/LibsslTLSContext.cc
index c9a1aea..7f81386 100644
--- a/src/LibsslTLSContext.cc
+++ b/src/LibsslTLSContext.cc
@@ -369,4 +369,51 @@ bool OpenSSLTLSContext::configurePeerVerification(
   return true;
 }
 
+bool OpenSSLTLSContext::configureBtPeer(
+    const std::string& cert, const std::string& key, const std::string& ca,
+    const std::string& groups, const std::string& suites, const std::string& alpn)
+{
+#if OPENSSL_VERSION_NUMBER >= 0x30500000L && !defined(LIBRESSL_VERSION_NUMBER)
+  if (!good() || groups != "X25519MLKEM768" || alpn != "aria2-bt/1" ||
+      cert.empty() || key.empty() || ca.empty()) return false;
+  if (suites != "TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256" &&
+      suites != "TLS_AES_256_GCM_SHA384" &&
+      suites != "TLS_CHACHA20_POLY1305_SHA256") return false;
+  SSL_CTX_set_default_passwd_cb(sslCtx_, [](char*, int, int, void*) -> int { return 0; });
+  if (SSL_CTX_set_min_proto_version(sslCtx_, TLS1_3_VERSION) != 1 ||
+      SSL_CTX_set_max_proto_version(sslCtx_, TLS1_3_VERSION) != 1 ||
+      SSL_CTX_set1_groups_list(sslCtx_, groups.c_str()) != 1 ||
+      SSL_CTX_set_ciphersuites(sslCtx_, suites.c_str()) != 1 ||
+      !configurePeerVerification(TLSVerification::CustomCA, ca) ||
+      !addCredentialFile(cert, key) || SSL_CTX_check_private_key(sslCtx_) != 1)
+    return false;
+  // No interactive passphrase prompt in a daemon/event loop.
+  SSL_CTX_set_session_cache_mode(sslCtx_, SSL_SESS_CACHE_OFF);
+  SSL_CTX_set_options(sslCtx_, SSL_OP_NO_TICKET);
+  if (SSL_CTX_set_num_tickets(sslCtx_, 0) != 1 ||
+      SSL_CTX_set_max_early_data(sslCtx_, 0) != 1) return false;
+  SSL_CTX_set_verify(sslCtx_, SSL_VERIFY_PEER |
+                    (side_ == TLS_SERVER ? SSL_VERIFY_FAIL_IF_NO_PEER_CERT : 0), nullptr);
+  SSL_CTX_set_verify_depth(sslCtx_, 4);
+  static const unsigned char protocol[] = {10, 'a','r','i','a','2','-','b','t','/','1'};
+  if (side_ == TLS_CLIENT) {
+    if (SSL_CTX_set_alpn_protos(sslCtx_, protocol, sizeof(protocol)) != 0) return false;
+  }
+  else {
+    SSL_CTX_set_alpn_select_cb(sslCtx_, [](SSL*, const unsigned char** out,
+        unsigned char* outlen, const unsigned char* in, unsigned int inlen, void*) -> int {
+      unsigned char* selected = nullptr;
+      if (SSL_select_next_proto(&selected, outlen, protocol, sizeof(protocol), in, inlen)
+          != OPENSSL_NPN_NEGOTIATED) return SSL_TLSEXT_ERR_ALERT_FATAL;
+      *out = selected;
+      return SSL_TLSEXT_ERR_OK;
+    }, nullptr);
+  }
+  btPeer_ = true;
+  return true;
+#else
+  return false;
+#endif
+}
+
 } // namespace aria2
