"""Rotate per-device instruction decryption keys.

Usage:
  iris-instr-key rotate [--no-overlap] <device_id>

Task 12 commits instruction-secret custody first and then hands the nonsecret
key ID to Task 13's one-device stamper. No command prints or accepts key bytes.
"""
import argparse
import importlib
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import secretfs       # noqa: E402
import secrets_store  # noqa: E402


class InstructionKeyCLIError(Exception):
    """A pre-commit rotation step failed without exposing tool details."""


class RestampIncomplete(InstructionKeyCLIError):
    """The secret commit succeeded but the Task 13 handoff did not."""


def _parser():
    parser = argparse.ArgumentParser(
        prog="iris-instr-key",
        description="Rotate an IRIS device instruction key",
        allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)
    rotate = commands.add_parser(
        "rotate", help="rotate one enrolled device", allow_abbrev=False)
    rotate.add_argument("--no-overlap", action="store_true",
                        help="retire every old server-side key immediately")
    rotate.add_argument("device_id")
    return parser


def resolve_default_restamp():
    """Resolve Task 13 lazily so help and injected foundation tests still work."""
    try:
        module = importlib.import_module("instruction_stamper")
        callback = getattr(module, "restamp_instruction_key")
    except Exception:
        raise InstructionKeyCLIError("instruction stamper unavailable")
    if not callable(callback):
        raise InstructionKeyCLIError("instruction stamper unavailable")
    return callback


def handoff_restamp(callback, device_id, key_id):
    """Invoke the idempotent Task 13 seam using nonsecret identity only."""
    if not callable(callback):
        raise InstructionKeyCLIError("instruction stamper unavailable")
    try:
        result = callback(device_id, key_id)
    except Exception:
        raise RestampIncomplete(
            "instruction key rotation persisted; restamping is incomplete")
    if result is False:
        raise RestampIncomplete(
            "instruction key rotation persisted; restamping is incomplete")


def rotate_device(device_id, no_overlap=False, restamp=None, now=None):
    """Commit one rotation, release the secret lock, then request restamping."""
    if not isinstance(device_id, str) or not device_id:
        raise InstructionKeyCLIError("invalid device id")
    try:
        secrets_store.validate_device_id(device_id)
    except ValueError:
        raise InstructionKeyCLIError("invalid device id")

    # Resolve the known integration prerequisite before any destructive
    # no-overlap mutation. The callback is invoked only after persistence.
    callback = restamp if restamp is not None else resolve_default_restamp()
    if not callable(callback):
        raise InstructionKeyCLIError("instruction stamper unavailable")

    secrets_path = os.environ.get("IRIS_SECRETS", "/run/iris/secrets.json")
    recipients = os.environ.get("IRIS_AGE_RECIPIENTS", "")
    enc_path = os.environ.get(
        "IRIS_SECRETS_ENC", "/etc/iris/secrets.json.age")
    clock = time.time if now is None else now

    try:
        with secrets_store.store_lock(secrets_path):
            try:
                store = secrets_store.load(secrets_path)
            except secrets_store.StoreCorruptError:
                raise InstructionKeyCLIError(
                    "instruction key store unavailable")
            key_id = secrets_store.rotate_instruction_key(
                store, device_id, clock(), no_overlap=no_overlap)
            try:
                secretfs.persist_store(
                    store, secrets_path,
                    recipients_csv=recipients, enc_path=enc_path)
            except Exception:
                raise InstructionKeyCLIError(
                    "instruction key persistence failed")
    except (InstructionKeyCLIError, secrets_store.InstructionKeyError):
        raise
    except Exception:
        raise InstructionKeyCLIError("instruction key store unavailable")

    handoff_restamp(callback, device_id, key_id)
    return key_id


def main(argv=None, restamp=None, now=None):
    parser = _parser()
    try:
        args = parser.parse_args(sys.argv[1:] if argv is None else argv)
    except SystemExit as exc:
        return int(exc.code)
    try:
        key_id = rotate_device(
            args.device_id, no_overlap=args.no_overlap,
            restamp=restamp, now=now)
    except (InstructionKeyCLIError, secrets_store.InstructionKeyError) as exc:
        print("iris-instr-key: %s" % exc, file=sys.stderr)
        return 1
    print(json.dumps({
        "device_id": args.device_id,
        "key_id": key_id,
        "state": "rotated",
    }, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
