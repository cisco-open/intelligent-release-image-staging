# Copy to server/server.env and replace the example addresses and paths.
# Keep the age private key and management token in files, never in this file.
COMPOSE_PROJECT_NAME=iris-server
IRIS_CONTAINER=iris
IRIS_HOST_IP=192.0.2.10
# Bind 9443 to this host's private management interface, never 0.0.0.0.
IRIS_MANAGEMENT_BIND_IP=192.0.2.10
IRIS_CONSOLE_URL=https://console.example.com:8080
IRIS_AGE_KEY_FILE_HOST=/etc/iris/age-identity.txt
IRIS_AGE_RECIPIENTS=REPLACE_WITH_PRIMARY_AND_OFFLINE_RECIPIENTS
IRIS_TIER_AUTH_DIR=/etc/iris/docker-hosts/tier-auth
IRIS_MANAGEMENT_TLS_DIR=/etc/iris/docker-hosts/management-tls
IRIS_IMAGE_ROOT=/opt/images
IRIS_ARTIFACTS_HOST_DIR=/opt/iris/artifacts
