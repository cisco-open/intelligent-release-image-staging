# Copy to server/console.env and replace the example addresses and paths.
# This host needs no server age key, image store, or device-facing address.
COMPOSE_PROJECT_NAME=iris-console
IRIS_CONSOLE_CONTAINER=iris-console
IRIS_CONSOLE_BIND_IP=192.0.2.20
IRIS_GUI_PUBLISH=8080
IRIS_MANAGEMENT_API_URL=https://iris-mgmt.example.com:9443
IRIS_TIER_AUTH_DIR=/etc/iris/docker-hosts/tier-auth
IRIS_MANAGEMENT_CA_DIR=/etc/iris/docker-hosts/management-ca
IRIS_CONSOLE_TLS_DIR=/etc/iris/docker-hosts/console-tls
