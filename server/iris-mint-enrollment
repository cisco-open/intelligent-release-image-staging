"""Mint a short-lived enrollment catalog token for a device.

The enrollment token overrides the standard TTL with IRIS_ENROLL_TTL
(default 3600 s) so it is short-lived regardless of the registry TTL.
The agent's first tick refreshes it into a rolling 7-day token.

Usage:
  iris-mint-enrollment <device_id>
"""
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import auth            # noqa: E402
import peer_endpoints  # noqa: E402
import secretfs       # noqa: E402
import secrets_store  # noqa: E402


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv

    if len(argv) != 1:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    device_id = argv[0]
    try:
        secrets_store.validate_device_id(device_id)
    except ValueError as exc:
        print("error: %s" % exc, file=sys.stderr)
        return 2
    secrets_path = os.environ.get("IRIS_SECRETS", "/run/iris/secrets.json")
    enroll_ttl = int(os.environ.get("IRIS_ENROLL_TTL", "3600"))
    state_dir = os.environ.get("IRIS_STATE", "/var/lib/iris")
    endpoints_path = os.path.join(state_dir, "peer-endpoints.json")

    now = time.time()

    # Re-onboard MUST clear the device's old retained endpoint rows BEFORE the
    # new credentials become usable (spec §7 retirement item 4): a stale
    # endpoint left over from a prior revoke/delete would otherwise keep the
    # reconciler denying the IP even after re-enrollment. The device principal
    # is ``device:<device_id>`` — deliberately distinct from the ``service:seeder``
    # namespace, so a device literally named "seeder" clears its own rows, never
    # the service seeder's. If this clear fails, abort before any new credential
    # is minted or persisted (nothing has been written yet).
    try:
        peer_endpoints.clear_principal(
            endpoints_path, auth.Principal("device", device_id))
    except (OSError, peer_endpoints.EndpointStoreError) as exc:
        print("error: endpoint clear failed, enrollment NOT minted: %s" % exc,
              file=sys.stderr)
        return 1

    # Hold the same advisory lock the catalog server's token-refresh takes, so
    # a concurrent rotation/revoke can't load a snapshot that predates this
    # mint and write it back, dropping the freshly minted enrollment token.
    with secrets_store.store_lock(secrets_path):
        store = secrets_store.load(secrets_path)
        token = secrets_store.mint(store, device_id, "catalog_token", now)

        # Override the registry TTL: enrollment tokens are intentionally short-lived.
        # Coerce int: time.time() is float; the store schema uses int epoch seconds.
        store["devices"][device_id]["catalog_token"]["expires_at"] = int(now) + enroll_ttl

        # Provision the device's stable secrets so the agent's first token-refresh
        # can hand them back. The installer bakes NEITHER — the agent fetches both
        # on that first refresh, which returns whatever is in the device record:
        #   announce_token — the device's key to the private tracker (join the swarm)
        #   rpc_secret     — the token for the agent's on-box aria2c RPC
        # Mint only if absent so re-enrolling a device does not churn an
        # announce/rpc out from under an already-running agent.
        dev = store["devices"][device_id]
        if not secrets_store.valid(dev.get("announce_token", {}), now, 0):
            secrets_store.mint(store, device_id, "announce_token", now)
        if not secrets_store.valid(dev.get("rpc_secret", {}), now, 0):
            secrets_store.mint(store, device_id, "rpc_secret", now)

        # Persist durable-FIRST: the at-rest .age ciphertext is the only copy
        # that survives a restart.  If the tmpfs plaintext were written first and
        # the durable encrypt then failed, a restart would decrypt the stale
        # ciphertext and the freshly minted enrollment token would be gone — the
        # device would fail auth on its first tick.  persist_store writes (and
        # confirms) the durable copy BEFORE swapping the live plaintext, so a
        # durable failure raises here and we do NOT print a token we did not
        # durably persist.
        recipients = os.environ.get("IRIS_AGE_RECIPIENTS", "")
        enc_path = os.environ.get(
            "IRIS_SECRETS_ENC", "/etc/iris/secrets.json.age")
        try:
            secretfs.persist_store(
                store, secrets_path,
                recipients_csv=recipients, enc_path=enc_path)
        except Exception as exc:
            print("error: durable persist failed, enrollment NOT minted: %s"
                  % exc, file=sys.stderr)
            return 1

    print(token)
    return 0


if __name__ == "__main__":
    sys.exit(main())
