# Bare-metal secrets unseal — the systemd mirror of docker-entrypoint.sh's
# decrypt block. Each iris-*.service runs this as an ExecStartPre so the
# *.age ciphertext on the persistent /etc/iris config dir is decrypted to a
# tmpfs (/run/iris, the unit's RuntimeDirectory) BEFORE the service process
# starts. Reuses the same secretfs.decrypt_to mechanism the container uses;
# never persists plaintext. Idempotent: safe to run once per unit.
#
# Fails closed: a missing master key or missing/undecryptable ciphertext
# aborts (non-zero) so the service does not start with no secret material.
set -euo pipefail

IRIS_CONFIG="${IRIS_CONFIG:-/etc/iris}"
IRIS_RUN="${IRIS_RUN:-/run/iris}"
IRIS_AGE_BIN="${IRIS_AGE_BIN:-age}"
# The master age identity is operator-held and lives OUTSIDE the config dir
# (never co-resident with the ciphertext it opens).
IRIS_AGE_KEY_FILE="${IRIS_AGE_KEY_FILE:-/etc/iris-key/.iris_age_key}"
# TLS trust + console-cert override (console-managed; absent = prior behavior)
IRIS_TRUST_DIR="${IRIS_TRUST_DIR:-$IRIS_CONFIG/tls/trust}"
IRIS_CA_BUNDLE="${IRIS_CA_BUNDLE:-$IRIS_RUN/tls/ca-bundle.pem}"
IRIS_GUI_CERT="${IRIS_GUI_CERT:-$IRIS_RUN/tls/gui-cert.pem}"

script_dir="$(cd "$(dirname "$0")" && pwd)"

mkdir -p "$IRIS_RUN/tls"
chmod 700 "$IRIS_RUN"

# Missing key => fail closed before any plaintext is written.
if [ ! -f "$IRIS_AGE_KEY_FILE" ]; then
  echo "FATAL: master key $IRIS_AGE_KEY_FILE not found — refusing to start (fail closed)" >&2
  exit 1
fi

# Decrypt the three secret files from the volume into tmpfs (/run/iris).
# decrypt_to fails closed: a bad/invalid key raises and nothing plaintext
# lands on the volume.
for pair in \
  "$IRIS_CONFIG/secrets.json.age:$IRIS_RUN/secrets.json" \
  "$IRIS_CONFIG/rpc-secret.age:$IRIS_RUN/rpc-secret" \
  "$IRIS_CONFIG/tls/key.pem.age:$IRIS_RUN/tls/key.pem"; do
  enc="${pair%%:*}"; out="${pair##*:}"
  if [ ! -f "$enc" ]; then
    echo "FATAL: encrypted file $enc missing — refusing to start (fail closed)" >&2
    exit 1
  fi
  IRIS_AGE_BIN="$IRIS_AGE_BIN" PYTHONPATH="$script_dir" python3 - "$enc" "$out" "$IRIS_AGE_KEY_FILE" <<'PY' || {
import os, sys
import secretfs
secretfs.decrypt_to(sys.argv[1], sys.argv[2], sys.argv[3],
                    age_bin=os.environ["IRIS_AGE_BIN"])
PY
    echo "FATAL: could not decrypt $enc — bad master key? (fail closed)" >&2
    exit 1
  }
done

# Build the plaintext combined cert (cert+key) in tmpfs for ssl.load_cert_chain.
# Write atomically: all three iris-*.service units share one RuntimeDirectory
# (/run/iris) and each runs this helper as an ExecStartPre, so on a cold boot up
# to three iris-secretfs processes hit this step concurrently.  A bare redirect
# truncates-then-writes in place, so a concurrent reader (another unit's catalog
# loading the cert) could see a half-written file.  A unique temp in the same
# dir + mv makes the swap a single rename: a reader sees either the old file or
# the complete new one, never a partial.  The content is identical across all
# instances (crt.pem is static; key.pem was already written atomically above),
# so racing renames are harmless.
cert_tmp="$(mktemp "$IRIS_RUN/tls/.cert.pem.XXXXXX")"
cat "$IRIS_CONFIG/tls/crt.pem" "$IRIS_RUN/tls/key.pem" > "$cert_tmp"
chmod 600 "$cert_tmp"
mv -f "$cert_tmp" "$IRIS_RUN/tls/cert.pem"

# Optional console-only cert override — mirrors docker-entrypoint.sh. Best
# effort BY DESIGN: this helper is every unit's ExecStartPre, so a corrupt or
# undecryptable CONSOLE cert must warn and be skipped, never abort the
# unseal — otherwise a bad cert upload would take the tracker/catalog down.
# gui_server falls back to IRIS_CERT while the override is absent; the rm on
# failure clears a stale override left by RuntimeDirectoryPreserve=yes.
# Same atomic temp + mv as cert.pem above (concurrent ExecStartPre races;
# the content is identical across instances, so racing renames are harmless).
if [ -f "$IRIS_CONFIG/tls/gui-crt.pem" ] && [ -f "$IRIS_CONFIG/tls/gui-key.pem.age" ]; then
  if IRIS_AGE_BIN="$IRIS_AGE_BIN" PYTHONPATH="$script_dir" python3 - \
      "$IRIS_CONFIG/tls/gui-key.pem.age" "$IRIS_RUN/tls/gui-key.pem" "$IRIS_AGE_KEY_FILE" <<'PY'
import os, sys
import secretfs
secretfs.decrypt_to(sys.argv[1], sys.argv[2], sys.argv[3],
                    age_bin=os.environ["IRIS_AGE_BIN"])
PY
  then
    # gui_tls.persist_override writes the durable pair key-first, then cert —
    # a crash between the two can leave a NEW key paired with a STALE cert on
    # the volume. Compare public keys (not modulus: future-proof beyond the
    # RSA iris-bootstrap mints today) before ever combining them into a
    # servable file, so a mismatched pair warns and falls back instead of
    # crashing later inside ssl.load_cert_chain.
    gui_cert_pub="$(openssl x509 -in "$IRIS_CONFIG/tls/gui-crt.pem" -noout -pubkey 2>/dev/null)" || gui_cert_pub=""
    gui_key_pub="$(openssl pkey -in "$IRIS_RUN/tls/gui-key.pem" -pubout 2>/dev/null)" || gui_key_pub=""
    if [ -n "$gui_cert_pub" ] && [ "$gui_cert_pub" = "$gui_key_pub" ]; then
      gui_tmp="$(mktemp "$IRIS_RUN/tls/.gui-cert.pem.XXXXXX")"
      cat "$IRIS_CONFIG/tls/gui-crt.pem" "$IRIS_RUN/tls/gui-key.pem" > "$gui_tmp"
      chmod 600 "$gui_tmp"
      mv -f "$gui_tmp" "$IRIS_GUI_CERT"
    else
      echo "WARNING: iris-secretfs: gui-crt.pem and gui-key.pem.age do not form a matching certificate/key pair — console keeps the built-in certificate" >&2
      rm -f "$IRIS_RUN/tls/gui-key.pem" "$IRIS_GUI_CERT"
    fi
  else
    echo "WARNING: iris-secretfs: could not decrypt tls/gui-key.pem.age — console keeps the built-in certificate" >&2
    rm -f "$IRIS_RUN/tls/gui-key.pem" "$IRIS_GUI_CERT"
  fi
fi

# Outbound-TLS trust bundle: deterministic lexicographic concat of the
# durable trust dir into tmpfs — must match server/trust.py
# rebuild_bundle(). The trust dir may not exist (created by install.sh /
# iris-bootstrap / the console), and units other than the console mount
# /etc/iris READ-ONLY under ProtectSystem=strict, so never try to create it
# here. Empty/missing dir removes any stale bundle (RuntimeDirectoryPreserve
# keeps /run/iris across restarts); non-empty builds atomically for the same
# concurrent-ExecStartPre reason as cert.pem.
trust_srcs=()
if [ -d "$IRIS_TRUST_DIR" ]; then
  shopt -s nullglob
  trust_srcs=("$IRIS_TRUST_DIR"/*.pem)
  shopt -u nullglob
fi
if [ "${#trust_srcs[@]}" -gt 0 ]; then
  bundle_tmp="$(mktemp "$IRIS_RUN/tls/.ca-bundle.pem.XXXXXX")"
  cat "${trust_srcs[@]}" > "$bundle_tmp"
  chmod 600 "$bundle_tmp"
  mv -f "$bundle_tmp" "$IRIS_CA_BUNDLE"
else
  rm -f "$IRIS_CA_BUNDLE"
fi

echo "iris-secretfs: secrets decrypted to $IRIS_RUN"
