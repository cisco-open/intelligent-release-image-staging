[Unit]
Description=intelligent-release-image-staging (IRIS) — HTTPS artifact server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iris
Group=iris
Environment=IRIS_CONFIG=/etc/iris
Environment=IRIS_RUN=/run/iris
Environment=IRIS_STATE=/var/lib/iris
Environment=IRIS_SECRETS=/run/iris/secrets.json
Environment=IRIS_CERT=/run/iris/tls/cert.pem
Environment=IRIS_ARTIFACTS_DIR=/srv/artifacts
# Optional operator overrides (e.g. IRIS_AGE_RECIPIENTS) — mirrors compose env.
EnvironmentFile=-/etc/iris/iris.env
RuntimeDirectory=iris
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=/opt/iris/server/iris-secretfs
ExecStart=/usr/bin/python3 /opt/iris/server/artifact_server.py
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ReadWritePaths=/var/lib/iris /srv/artifacts /run/iris
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
