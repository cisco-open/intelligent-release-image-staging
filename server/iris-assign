"""Assign images to devices (sets the catalog policy the devices poll).

Usage:
  iris-assign                          show published images + current assignments
  iris-assign <device_id> <image_id> [image_id ...]   merge ordered assignments
  iris-assign --replace <device_id> <image_id> [image_id ...]   replace assignments
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import catalog  # noqa: E402
import assignment_service  # noqa: E402
import gui_fleet  # noqa: E402


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    state_dir = os.environ.get("IRIS_STATE", "/var/lib/iris")
    store = catalog.CatalogStore(state_dir)

    if not argv:
        print("published images:")
        images = store.list_images()
        for i in images:
            print("  %-40s sha256 %s..." % (i["id"], i["sha256"][:12]))
        if not images:
            print("  (none — publish one with iris-publish)")
        print("assignments:")
        policies = store.list_policies()
        for sid in sorted(policies):
            print("  %-20s -> %s" % (sid, ", ".join(store.get_policy(sid)["approved_image_ids"]) or "(none)"))
        if not policies:
            print("  (none)")
        return 0

    replace = argv[0] == "--replace"
    args = argv[1:] if replace else argv
    if len(args) < 2 or any(arg.startswith("--") for arg in args):
        print(__doc__.strip(), file=sys.stderr)
        return 2

    device_id, *image_ids = args
    service = assignment_service.AssignmentService(
        store, gui_fleet.FleetStore(state_dir),
        os.environ.get("IRIS_AUDIT", "/etc/iris/audit.jsonl"))
    try:
        result = service.apply(device_id, image_ids, actor="cli:iris-assign",
                               mode="replace" if replace else "merge",
                               retry_conflict=True)
    except catalog.QuarantinedImage as exc:
        hv = exc.hash_verification or {}
        reason = hv.get("state") or "unknown"
        if hv.get("deferral"):
            reason += ", deferred by Cisco"
        print("error: image '%s' is quarantined (%s)"
              % (exc.image_id, reason), file=sys.stderr)
        return 1
    except (ValueError, catalog.PolicyConflict, gui_fleet.FleetStateError) as exc:
        print("error: %s" % exc, file=sys.stderr)
        return 1
    print("assigned %s -> %s  (the device picks it up within ~60s)"
          % (device_id, ", ".join(result.after_ids)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except catalog.StateFileError as exc:
        # A state file under IRIS_STATE exists but cannot be read. Fail
        # closed with the same one-line diagnosis the other credential and
        # assignment CLIs give, rather than a traceback: the operator needs
        # to know WHICH file to repair, and nothing must be written over a
        # file whose contents are still recoverable.
        print("error: %s" % exc, file=sys.stderr)
        sys.exit(1)
