# intelligent-release-image-staging — deployment credentials (TEMPLATE).
#
# Copy this to creds/deploy.env and fill in the real values:
#     cp creds/deploy.env.example creds/deploy.env
#     # then edit creds/deploy.env
#
# creds/deploy.env is gitignored and never committed. Keeping secrets in this
# file (instead of pasting them into a chat prompt) means an AI assistant
# driving the deployment can read them here and use them WITHOUT you ever
# typing a password into the conversation. Load it in a shell with:
#     source creds/deploy.env
#
# BOTH blocks below are OPTIONAL — fill in only what you want the assistant
# to do for you.
#
# SPDX-License-Identifier: Apache-2.0

# --- the server (the Linux box that runs the tool) ---
# With these set, the assistant can SSH into the server and do the one-time
# bring-up for you (install Docker/age, write server/.env, docker compose up).
# If you plan to bring the server up yourself through the CLI, the procedure
# is different — follow the README chapter "Stand up the server" — and you
# can omit SERVER_* entirely.
export SERVER_HOST=203.0.113.10          # server IP or hostname
export SERVER_USER=admin                 # your SSH login on the server
export SERVER_PASS=change-me             # SSH password (or use an SSH key + omit this)

# --- the devices being staged ---
# NOT required if you drive the deployment from the web Console: there you
# type the device login into a credential profile in your browser and it is
# stored server-side. Set these only if you want the assistant to fill in the
# credential profile for you, or if you run the CLI helpers unattended.
export DEVICE_USER=admin                 # device login username
export DEVICE_PASS=change-me             # device login password
export DEVICE_ENABLE=change-me           # enable secret (blank -> same as DEVICE_PASS)
